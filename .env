# ========================================================
# Sarathi AI — PCMC Civic Intelligence Configuration
# ========================================================

# General Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Content Moderation & Guardrails
ENABLE_PII_MASKING=true
ENABLE_PROFANITY_FILTER=true
ENABLE_PROMPT_INJECTION_CHECK=true
ENABLE_FILE_VALIDATION=true
ENABLE_OUTPUT_MODERATION=true
PROFANITY_SENSITIVITY=0.8
PROMPT_INJECTION_THRESHOLD=0.7
MAX_FILE_SIZE_BYTES=15728640

# LLM Providers (Configure at least one)
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Vector DB & Storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pcmc_sarathi

# WhatsApp Business Webhook
WHATSAPP_VERIFY_TOKEN=pcmc_sarathi_webhook_token_2026
WHATSAPP_API_TOKEN=
